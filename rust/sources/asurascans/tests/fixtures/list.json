{"data": [{"id": 2165, "slug": "overgeared", "title": "Overgeared", "alt_titles": ["템빨", "Temppal", "Grid's Item Peak", "Item Overgeared", "Over Power", "テムパル", "装备之神", "Во всеоружии", "مجهز بالكامل", "Trâm Anh Thế Phiệt", "Suréquipé", "Equipado Hasta Los Dientes", "O Super Equipado", "Terlalu Banyak Diperlengkapi"], "description": "Shin Youngwoo (a.k.a. Greed), an unlucky man in life and a low-level player in the popular VR game “Satisfy,” finds a powerful item that earns him a rare legendary class title: “Pagma’s Successor.” He’s now a skilled blacksmith who can forge unique weapons and equip the game’s most powerful gear. Grid resolves to use his new abilities to achieve fame and fortune, but as his very existence begins to stir up trouble in Satisfy, he realizes that life as a legend may be more than he bargained for….</p>", "cover": "https://cdn.asurascans.com/asura-images/covers/overgeared.905990.webp", "banner": "https://cdn.asurascans.com/asura-images/banners/overgeared.jpg", "status": "ongoing", "type": "manhwa", "author": "LEE Dong Wook/ PARK Saenal", "artist": "REDICE Studio", "popularity_rank": 1, "bookmark_count": 60154, "rating": 9.190368698269376, "chapter_count": 345, "last_chapter_at": "2026-10-16T20:05:29.882866Z", "created_at": "0001-01-01T00:00:00Z", "updated_at": "2026-10-17T19:37:48.723366Z", "public_url": "/comics/overgeared-1bb35e56", "source_url": "/s/2165", "genres": [{"id": 1, "name": "Action", "slug": "action"}, {"id": 4, "name": "Adventure", "slug": "adventure"}, {"id": 7, "name": "Comedy", "slug": "comedy"}, {"id": 16, "name": "Fantasy", "slug": "fantasy"}, {"id": 18, "name": "Game", "slug": "game"}]}, {"id": 2012, "slug": "sss-class-suicide-hunter", "title": "SSS-Class Suicide Hunter", "alt_titles": ["SSS级重生猎人", "SSS급 죽어야 사는 헌터", "SSS級死而復生的獵人", "SSS级自杀猎人", "死して生きるSSS級ハンター", "SSS-Class Revival Hunter", "SSS-geup Jugeoya Saneun Hunter", "SSS 級自殺 Hunter", "SSS级复兴猎人", "Thợ Săn Tự Sát Cấp SSS", "شکارچی با مهارت خودکشی سطح SSS", "นักล่าพลีชี